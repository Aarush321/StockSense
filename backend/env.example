# AI API Keys (at least one required for AI recommendations)
# These use official Python SDKs: pip install anthropic openai
# Copy your actual keys to .env file (this file is for reference only)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Financial Data APIs (optional, yfinance + Yahoo chart + FMP used as fallbacks)
# These use REST APIs via requests library (no SDK needed)
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
FMP_API_KEY=your_fmp_api_key_here
NEWS_API_KEY=your_news_api_key_here

# Social Media APIs (optional)
# StockTwits: FREE, no API key needed! Already implemented.
# Reddit: Using simple scraping (no API key needed, but be respectful of rate limits)

# Authentication & Security
JWT_SECRET_KEY=your-secret-key-change-in-production-use-random-string-here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000,http://localhost:5001,https://your-netlify-url.netlify.app

# Email Service Configuration (choose ONE option below)
# Option 1: SendGrid (Recommended - Free tier: 100 emails/day)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@stocksense.com

# Option 2: SMTP (Gmail, Outlook, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Frontend URL (for email verification and password reset links)
# Replace with your actual Netlify URL
FRONTEND_URL=https://your-netlify-url.netlify.app
# Twitter: Optional - requires API key for real data (otherwise uses calculated sentiment)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

